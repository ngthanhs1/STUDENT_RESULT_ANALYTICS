<Window x:Class="RESULT_ANALYTICS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RESULT_ANALYTICS.Views"
        Title="Hệ thống Quản lý Đào tạo và Kết quả Học tập Đại học - Student Result Analytics"
        Icon="/Assets/logo.png"
        Height="740" Width="1240"
        MinHeight="620" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <!-- ============================= -->
    <!-- TAI NGUYEN GIAO DIEN -->
    <!-- ============================= -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- STYLE BUTTON MENU SIDEBAR CO BAN -->
        <Style x:Key="ClassicMenuBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="{Binding DataContext.CanLeNoiDungMenu, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#255280"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#123356"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLES CO DINH CHO TUNG MENU KHI DANG DUOC CHON (ACTIVE STATE) -->
        <Style x:Key="MenuBtn_Dashboard" TargetType="Button" BasedOn="{StaticResource ClassicMenuBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDashboardSelected}" Value="True">
                    <Setter Property="Background" Value="#123356"/>
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                    <Setter Property="BorderThickness" Value="3.5,0,0,0"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuBtn_SinhVienLop" TargetType="Button" BasedOn="{StaticResource ClassicMenuBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSinhVienLopSelected}" Value="True">
                    <Setter Property="Background" Value="#123356"/>
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                    <Setter Property="BorderThickness" Value="3.5,0,0,0"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuBtn_MonHocHocKy" TargetType="Button" BasedOn="{StaticResource ClassicMenuBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMonHocHocKySelected}" Value="True">
                    <Setter Property="Background" Value="#123356"/>
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                    <Setter Property="BorderThickness" Value="3.5,0,0,0"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuBtn_NhapDiem" TargetType="Button" BasedOn="{StaticResource ClassicMenuBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNhapDiemSelected}" Value="True">
                    <Setter Property="Background" Value="#123356"/>
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                    <Setter Property="BorderThickness" Value="3.5,0,0,0"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuBtn_ImportDiem" TargetType="Button" BasedOn="{StaticResource ClassicMenuBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsImportDiemSelected}" Value="True">
                    <Setter Property="Background" Value="#123356"/>
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                    <Setter Property="BorderThickness" Value="3.5,0,0,0"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuBtn_PhanTich" TargetType="Button" BasedOn="{StaticResource ClassicMenuBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPhanTichSelected}" Value="True">
                    <Setter Property="Background" Value="#123356"/>
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                    <Setter Property="BorderThickness" Value="3.5,0,0,0"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuBtn_CanhBao" TargetType="Button" BasedOn="{StaticResource ClassicMenuBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCanhBaoSelected}" Value="True">
                    <Setter Property="Background" Value="#123356"/>
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                    <Setter Property="BorderThickness" Value="3.5,0,0,0"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuBtn_HeThong" TargetType="Button" BasedOn="{StaticResource ClassicMenuBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeThongSelected}" Value="True">
                    <Setter Property="Background" Value="#123356"/>
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                    <Setter Property="BorderThickness" Value="3.5,0,0,0"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- TEMPLATES CHO TUNG PHAN HE -->
        <DataTemplate x:Key="DashboardTemplate">
            <views:DashboardView/>
        </DataTemplate>

        <DataTemplate x:Key="SinhVienTemplate">
            <views:QuanLySinhVienView/>
        </DataTemplate>

        <DataTemplate x:Key="MonHocHocKyTemplate">
            <views:QuanLyMonHocHocKyView/>
        </DataTemplate>

        <DataTemplate x:Key="QuanLyDiemTemplate">
            <views:QuanLyDiemView/>
        </DataTemplate>

        <DataTemplate x:Key="PhanTichTemplate">
            <views:PhanTichView/>
        </DataTemplate>

        <DataTemplate x:Key="ThongKeCanhBaoTemplate">
            <views:ThongKeCanhBaoView/>
        </DataTemplate>

        <DataTemplate x:Key="HeThongImportTemplate">
            <views:HeThongImportView/>
        </DataTemplate>

        <DataTemplate x:Key="QuanLyTaiKhoanTemplate">
            <views:QuanLyTaiKhoanView/>
        </DataTemplate>

    </Window.Resources>

    <!-- ============================= -->
    <!-- BO CUC CHINH -->
    <!-- ============================= -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================= -->
        <!-- SIDEBAR BEN TRAI (CO THE THU GON / MO RONG) -->
        <!-- ============================= -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Width="230" Background="#1B426E" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LOGO, BAN QUYEN & NUT 3 GACH (HAMBURGER) -->
                <Border Grid.Row="0" BorderBrush="#254F77" BorderThickness="0,0,0,1" Padding="0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- NUT 3 GACH (HAMBURGER) LUON NAM O COT 60PX -> KHONG BAO GIO BI LECH / NHAY VI TRI -->
                        <Button Grid.Column="0" Click="ToggleSidebar_Click" Width="36" Height="36" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Cursor="Hand" ToolTip="Thu gọn / Mở rộng thanh bên (☰)" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <TextBlock Text="☰" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#255280"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#123356"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- LOGO VA TIEU DE (CHI HIEN THI KHI MO RONG) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding HienThiChuThanhBen}">
                            <Image Source="/Assets/logo.png" Height="28" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="RESULT ANALYTICS" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="CỔNG QUẢN LÝ ĐÀO TẠO" Foreground="#93C5FD" FontSize="8.5" FontWeight="SemiBold" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DANH SACH PHAN HE NGHIEP VU -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,6,0,10">

                        <!-- NHOM 1: TONG QUAN -->
                        <TextBlock Text="TỔNG QUAN" Foreground="#97B8D9" FontSize="10" FontWeight="Bold" Margin="14,6,0,3"
                                   Visibility="{Binding HienThiChuThanhBen}"/>
                        <Button Command="{Binding TrangChuCommand}" ToolTip="Tổng quan" Style="{StaticResource MenuBtn_Dashboard}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📊" FontSize="15" Width="24" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Tổng quan" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.HienThiChuThanhBen, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="#254F77" Margin="8,6"/>

                        <!-- NHOM 2: QUAN LY DAO TAO -->
                        <TextBlock Text="QUẢN LÝ ĐÀO TẠO" Foreground="#97B8D9" FontSize="10" FontWeight="Bold" Margin="14,4,0,3"
                                   Visibility="{Binding HienThiChuThanhBen}"/>
                        <Button Command="{Binding QuanLyLopSinhVienCommand}" ToolTip="Hồ sơ Sinh viên &amp; Lớp học" Style="{StaticResource MenuBtn_SinhVienLop}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="👨‍🎓" FontSize="15" Width="24" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Hồ sơ Sinh viên &amp; Lớp học" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.HienThiChuThanhBen, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding MonHocHocKyCommand}" ToolTip="Học phần &amp; Niên khóa" Style="{StaticResource MenuBtn_MonHocHocKy}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📚" FontSize="15" Width="24" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Học phần &amp; Niên khóa" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.HienThiChuThanhBen, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="#254F77" Margin="8,6"/>

                        <!-- NHOM 3: KHAO THI & DIEM SO -->
                        <TextBlock Text="KHẢO THÍ &amp; ĐIỂM SỐ" Foreground="#97B8D9" FontSize="10" FontWeight="Bold" Margin="14,4,0,3"
                                   Visibility="{Binding HienThiChuThanhBen}"/>
                        <Button Command="{Binding NhapDiemCommand}" ToolTip="Sổ điểm học phần" Style="{StaticResource MenuBtn_NhapDiem}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📝" FontSize="15" Width="24" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Sổ điểm học phần" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.HienThiChuThanhBen, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportDiemCommand}" ToolTip="Nhập điểm từ File (Excel/CSV)" Style="{StaticResource MenuBtn_ImportDiem}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📥" FontSize="15" Width="24" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Nhập điểm từ File (Excel/CSV)" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.HienThiChuThanhBen, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="#254F77" Margin="8,6"/>

                        <!-- NHOM 4: HOC VU & BAO CAO -->
                        <TextBlock Text="HỌC VỤ &amp; BÁO CÁO" Foreground="#97B8D9" FontSize="10" FontWeight="Bold" Margin="14,4,0,3"
                                   Visibility="{Binding HienThiChuThanhBen}"/>
                        <Button Command="{Binding PhanTichCommand}" ToolTip="Tra cứu GPA &amp; Học lực" Style="{StaticResource MenuBtn_PhanTich}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📈" FontSize="15" Width="24" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Tra cứu GPA &amp; Học lực" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.HienThiChuThanhBen, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CanhBaoCommand}" ToolTip="Thống kê Đạt/Trượt &amp; Cảnh báo" Style="{StaticResource MenuBtn_CanhBao}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚠️" FontSize="15" Width="24" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Thống kê Đạt/Trượt &amp; Cảnh báo" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.HienThiChuThanhBen, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                        </Button>

                        <!-- NHOM 5: QUAN TRI HE THONG (CHI HIEN THI KHI LA ADMIN) -->
                        <StackPanel Visibility="{Binding LaAdmin, Converter={StaticResource BoolToVis}}">
                            <Border Height="1" Background="#254F77" Margin="8,6"/>
                            <TextBlock Text="QUẢN TRỊ HỆ THỐNG" Foreground="#97B8D9" FontSize="10" FontWeight="Bold" Margin="14,4,0,3"
                                       Visibility="{Binding HienThiChuThanhBen}"/>
                            <Button Command="{Binding HeThongCommand}" ToolTip="Quản trị &amp; Phân quyền" Style="{StaticResource MenuBtn_HeThong}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚙️" FontSize="15" Width="24" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="Quản trị &amp; Phân quyền" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding DataContext.HienThiChuThanhBen, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- ==================================== -->
                <!-- THONG TIN TAI KHOAN VA DANG XUAT (NHỎ GỌN) -->
                <!-- ==================================== -->
                <Border Grid.Row="2" Background="#143457" BorderBrush="#254F77" BorderThickness="0,1,0,0" Padding="8,8">
                    <Grid>
                        <!-- KHI MO RONG (EXPANDED): AVATAR + TEN/QUYEN + NUT DANG XUAT NHO GON -->
                        <Grid Visibility="{Binding HienThiChuThanhBen}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- AVATAR -->
                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#255280" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="👤" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- TEN VA VAI TRO -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="{Binding TenDangNhap}" Foreground="White" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding VaiTro}" Foreground="#93C5FD" FontSize="10.5" FontWeight="SemiBold" Margin="0,1,0,0"/>
                            </StackPanel>

                            <!-- NUT DANG XUAT NHO GON (KHONG DAI TO) -->
                            <Button Grid.Column="2" Click="DangXuat_Click" Height="26" Padding="8,0" Background="#DC2626" Foreground="White" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" ToolTip="Đăng xuất khỏi hệ thống" VerticalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🚪" FontSize="11" Margin="0,0,4,0"/>
                                                <TextBlock Text="Đăng xuất" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#B91C1C"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#991B1B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- KHI THU GON (COLLAPSED): AVATAR VA NUT ICON DANG XUAT CAN GIUA -->
                        <StackPanel Visibility="{Binding HienThiIconThanhBen}" HorizontalAlignment="Center">
                            <!-- AVATAR NHO -->
                            <Border Width="28" Height="28" CornerRadius="14" Background="#255280" Margin="0,0,0,6" ToolTip="{Binding ThongTinNguoiDung}">
                                <TextBlock Text="👤" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- NUT DANG XUAT ICON VUONG NHO GOC -->
                            <Button Click="DangXuat_Click" Width="30" Height="26" Background="#DC2626" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Đăng xuất khỏi hệ thống" HorizontalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="3">
                                            <TextBlock Text="🚪" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#B91C1C"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#991B1B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- ============================= -->
        <!-- NOI DUNG BEN PHAI -->
        <!-- ============================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- THANH TIEU DE VA BREADCRUMB -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- BREADCRUMB NAVIGATION -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏛️ HỆ THỐNG ĐÀO TẠO" FontSize="10.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text=" › " FontSize="10.5" Foreground="#94A3B8" Margin="4,0"/>
                            <TextBlock Text="{Binding PhanHeHienTai}" FontSize="10.5" Foreground="#1E4E79" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TenTrang}" FontSize="16" FontWeight="Bold" Foreground="#0F243A" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- BADGE NAM HOC & TRANG THAI KET NOI (DONG) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- BO LOC HOC KY TOAN HE THONG -->
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📅 Kỳ xét:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding DanhSachHocKyHeThong}"
                                          SelectedValuePath="MaHocKy"
                                          DisplayMemberPath="TenHienThi"
                                          SelectedValue="{Binding MaHocKyToanHeThong, Mode=TwoWay}"
                                          FontSize="11"
                                          FontWeight="SemiBold"
                                          Foreground="#0F243A"
                                          Height="24"
                                          MinWidth="200"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          VerticalContentAlignment="Center"
                                          Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{Binding MauNenTrangThaiKetNoi}" CornerRadius="4" Padding="8,4" BorderBrush="#CBD5E1" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{Binding MauTrangThaiKetNoi}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TrangThaiKetNoi}" FontSize="11" Foreground="{Binding MauTrangThaiKetNoi}" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- VUNG HIEN THI CAC PHAN HE -->
            <ContentControl Grid.Row="1" Content="{Binding NoiDungHienTai}" Margin="14,10,14,10">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource DashboardTemplate}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MucDangChon}" Value="Dashboard">
                                <Setter Property="ContentTemplate" Value="{StaticResource DashboardTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MucDangChon}" Value="SinhVienLop">
                                <Setter Property="ContentTemplate" Value="{StaticResource SinhVienTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MucDangChon}" Value="MonHocHocKy">
                                <Setter Property="ContentTemplate" Value="{StaticResource MonHocHocKyTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MucDangChon}" Value="NhapDiem">
                                <Setter Property="ContentTemplate" Value="{StaticResource QuanLyDiemTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MucDangChon}" Value="ImportDiem">
                                <Setter Property="ContentTemplate" Value="{StaticResource HeThongImportTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MucDangChon}" Value="PhanTich">
                                <Setter Property="ContentTemplate" Value="{StaticResource PhanTichTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MucDangChon}" Value="CanhBao">
                                <Setter Property="ContentTemplate" Value="{StaticResource ThongKeCanhBaoTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MucDangChon}" Value="HeThong">
                                <Setter Property="ContentTemplate" Value="{StaticResource QuanLyTaiKhoanTemplate}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

        </Grid>
    </Grid>
</Window>
