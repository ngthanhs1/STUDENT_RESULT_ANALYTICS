<Window x:Class="RESULT_ANALYTICS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RESULT_ANALYTICS.Views"
        Title="Student Result Analytics"
        Height="700" Width="1200"
        MinHeight="600" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <!-- ============================= -->
    <!-- TAI NGUYEN GIAO DIEN -->
    <!-- ============================= -->
    <Window.Resources>

        <!-- STYLE MENU -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="#285477"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3572A3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DASHBOARD -->
        <DataTemplate x:Key="DashboardTemplate">
            <views:DashboardView/>
        </DataTemplate>

        <DataTemplate x:Key="SinhVienTemplate">
            <views:QuanLySinhVienView/>
        </DataTemplate>


        <!-- CAC TRANG CHUA PHAT TRIEN -->
        <DataTemplate x:Key="PlaceholderTemplate">
            <Border Background="White" CornerRadius="10" Padding="30" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="CHỨC NĂNG ĐANG PHÁT TRIỂN" FontSize="20" FontWeight="Bold" Foreground="#1E4E79"/>
                    <TextBlock Text="{Binding}" FontSize="15" Foreground="#64748B" TextWrapping="Wrap" Margin="0,15,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <!-- ============================= -->
    <!-- BO CUC CHINH -->
    <!-- ============================= -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================= -->
        <!-- SIDEBAR BEN TRAI -->
        <!-- ============================= -->
        <Border Grid.Column="0" Background="#173B59">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="110"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="85"/>
                </Grid.RowDefinitions>

                <!-- LOGO HE THONG -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="18,0">
                    <TextBlock Text="RESULT ANALYTICS" Foreground="White" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="QUẢN LÝ KẾT QUẢ HỌC TẬP" Foreground="#BED2E5" FontSize="11" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- DANH SACH MENU -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <TextBlock Text="DANH MỤC CHỨC NĂNG" Foreground="#B7CBDD" FontSize="11" FontWeight="Bold" Margin="20,12,0,15"/>

                        <Button Content="01. Dashboard tổng quan" Command="{Binding TrangChuCommand}" Style="{StaticResource MenuButtonStyle}"/>
                        <Button Content="02. Lớp và sinh viên" Command="{Binding QuanLyLopSinhVienCommand}" Style="{StaticResource MenuButtonStyle}"/>
                        <Button Content="03. Môn học và học kỳ" Command="{Binding MonHocHocKyCommand}" Style="{StaticResource MenuButtonStyle}"/>
                        <Button Content="04. Nhập và quản lý điểm" Command="{Binding NhapDiemCommand}" Style="{StaticResource MenuButtonStyle}"/>
                        <Button Content="05. Phân tích học lực" Command="{Binding PhanTichCommand}" Style="{StaticResource MenuButtonStyle}"/>
                        <Button Content="06. Thống kê và cảnh báo" Command="{Binding CanhBaoCommand}" Style="{StaticResource MenuButtonStyle}"/>
                        <Button Content="07. Hệ thống và Import" Command="{Binding HeThongCommand}" Style="{StaticResource MenuButtonStyle}"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- THONG TIN TAI KHOAN -->
                <Border Grid.Row="2" BorderBrush="#41627C" BorderThickness="0,1,0,0" Padding="18,10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding TenDangNhap}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding VaiTro}" FontSize="12" Foreground="#BED2E5" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ============================= -->
        <!-- NOI DUNG BEN PHAI -->
        <!-- ============================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- THANH TIEU DE -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid Margin="25,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding TenTrang}" FontSize="21" FontWeight="Bold" Foreground="#1E4E79" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="STUDENT RESULT ANALYTICS" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- VUNG HIEN THI CAC TRANG -->
            <ContentControl Grid.Row="1" Content="{Binding NoiDungHienTai}" Margin="24">

                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource DashboardTemplate}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DangODashboard}" Value="False">
                                <Setter Property="ContentTemplate" Value="{StaticResource PlaceholderTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TenTrang}" Value="Quản lý lớp và sinh viên">
                                <Setter Property="ContentTemplate" Value="{StaticResource SinhVienTemplate}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>

            </ContentControl>

        </Grid>
    </Grid>
</Window>
