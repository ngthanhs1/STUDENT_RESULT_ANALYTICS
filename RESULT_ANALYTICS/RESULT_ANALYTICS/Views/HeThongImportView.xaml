<UserControl x:Class="RESULT_ANALYTICS.Views.HeThongImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <!-- DINH DANG GIAO DIEN CO DIEN GON GANG -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ClassicBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="2,0,2,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- HANG 0: TIEU DE -->
            <RowDefinition Height="Auto"/> <!-- HANG 1: KHU VUC IMPORT FILE -->
            <RowDefinition Height="*"/>    <!-- HANG 2: BANG LICH SU IMPORT CUNG TRANG -->
        </Grid.RowDefinitions>

        <!-- HANG 0: TIEU DE -->
        <TextBlock Grid.Row="0" Text="NHẬP ĐIỂM THI TỪ FILE &amp; LỊCH SỬ IMPORT" FontSize="16" FontWeight="Bold" Foreground="#174A78" Margin="0,0,0,6"/>

        <!-- HANG 1: KHU VUC IMPORT FILE & KET QUA -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Height="28" Padding="8,3" Text="{Binding DuongDanFile}" IsReadOnly="True" Background="#F8FAFC" BorderBrush="#CBD5E1" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="📁 CHỌN FILE..." Command="{Binding ChonFileCommand}" Background="#1976D2" Style="{StaticResource ClassicBtn}" MinWidth="105" Margin="0,0,6,0"/>
                    <Button Grid.Column="2" Content="⚡ THỰC HIỆN IMPORT" Command="{Binding ImportFileCommand}" Background="#2E7D32" Style="{StaticResource ClassicBtn}" MinWidth="135"/>
                </Grid>

                <TextBlock Text="• Hỗ trợ file Excel (.xlsx) hoặc CSV (.csv). Định dạng 6 cột: MaSV, MaMonHoc, MaHocKy, DiemChuyenCan, DiemGiuaKy, DiemCuoiKy (Tối đa 5.000 dòng, thang điểm 0-10)" FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>

                <!-- 4 THE KET QUA IMPORT NẰM TRÊN 1 HÀNG -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#E3F2FD" CornerRadius="4" Padding="10,5" Margin="0,0,4,0" BorderBrush="#BBDEFB" BorderThickness="1" MinHeight="52">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TỔNG DÒNG" FontSize="10" Foreground="#1762A5" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TongSoDong}" FontSize="18" FontWeight="Bold" Foreground="#174A78" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#E8F5E9" CornerRadius="4" Padding="10,5" Margin="2,0,4,0" BorderBrush="#C8E6C9" BorderThickness="1" MinHeight="52">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="THÀNH CÔNG" FontSize="10" Foreground="#287D3C" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SoDongThanh}" FontSize="18" FontWeight="Bold" Foreground="#287D3C" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#FDE8E8" CornerRadius="4" Padding="10,5" Margin="2,0,4,0" BorderBrush="#FFCDD2" BorderThickness="1" MinHeight="52">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DÒNG LỖI" FontSize="10" Foreground="#C62828" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SoDongLoi}" FontSize="18" FontWeight="Bold" Foreground="#C62828" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="#FEF3C7" CornerRadius="4" Padding="10,5" Margin="2,0,0,0" BorderBrush="#FDE68A" BorderThickness="1" MinHeight="52">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TRẠNG THÁI" FontSize="10" Foreground="#B45309" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TrangThaiImport}" FontSize="13" FontWeight="Bold" Foreground="#B45309" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding ThongBaoImport}" Foreground="#1976D2" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ThongBaoLichSu}" Foreground="#C46A12" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- CHI TIET DONG LOI (NEU CO) -->
                <Border BorderBrush="#FED7AA" BorderThickness="1" Background="#FFF7ED" CornerRadius="3" Padding="8,5" Margin="0,6,0,0"
                        Visibility="{Binding CoLoi, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <StackPanel>
                        <TextBlock Text="Chi tiết các dòng không hợp lệ:" FontSize="11" FontWeight="Bold" Foreground="#C2410C" Margin="0,0,0,3"/>
                        <ScrollViewer MaxHeight="70" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DanhSachLoi}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#9A3412" FontSize="11" Margin="0,1,0,1" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- HANG 2: BANG LICH SU IMPORT CUNG TREN 1 TRANG -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="LỊCH SỬ CÁC LẦN IMPORT ĐIỂM (SQL SERVER)" FontSize="12.5" FontWeight="Bold" Foreground="#174A78" VerticalAlignment="Center"/>
                        <TextBlock Text="(Hiển thị 100 lần import gần nhất)" FontSize="11" Foreground="#64748B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" Content="🔄 LÀM MỚI LỊCH SỬ" Command="{Binding LamMoiLichSuCommand}" Background="#0284C7" Style="{StaticResource ClassicBtn}" MinWidth="125"/>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding DanhSachLichSu}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          AlternatingRowBackground="#F8FAFC"
                          GridLinesVisibility="Horizontal"
                          RowHeight="27"
                          ColumnHeaderHeight="30"
                          BorderBrush="#CBD5E1"
                          FontSize="11.5"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã" Binding="{Binding MaLichSu}" Width="55"/>
                        <DataGridTextColumn Header="Tên file" Binding="{Binding TenFile}" MinWidth="180" Width="*"/>
                        <DataGridTextColumn Header="Loại file" Binding="{Binding LoaiFile}" Width="75"/>
                        <DataGridTextColumn Header="Thời gian nạp" Binding="{Binding ThoiGianNhap, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="150"/>
                        <DataGridTextColumn Header="Tổng dòng" Binding="{Binding TongSoDong}" Width="85"/>
                        <DataGridTextColumn Header="Thành công" Binding="{Binding SoDongThanh}" Width="90"/>
                        <DataGridTextColumn Header="Dòng lỗi" Binding="{Binding SoDongLoi}" Width="75"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="105"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
