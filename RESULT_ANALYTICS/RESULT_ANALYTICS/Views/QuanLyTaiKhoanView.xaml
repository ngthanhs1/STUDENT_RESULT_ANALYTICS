<UserControl x:Class="RESULT_ANALYTICS.Views.QuanLyTaiKhoanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <!-- DINH DANG GIAO DIEN CO DIEN GON GANG -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ClassicBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NUT CHON TRANG THAI: MO KHOA (HOAT DONG) -->
        <Style x:Key="MoKhoaRadioBtn" TargetType="RadioButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="4" Padding="12,0" Margin="0,0,6,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DCFCE7"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#16A34A"/>
                                <Setter Property="Foreground" Value="#15803D"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NUT CHON TRANG THAI: DA KHOA -->
        <Style x:Key="DaKhoaRadioBtn" TargetType="RadioButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="4" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="#991B1B"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="2,0,2,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- HANG 0: TIEU DE & 3 THE KPI -->
            <RowDefinition Height="Auto"/> <!-- HANG 1: FORM THONG TIN TAI KHOAN -->
            <RowDefinition Height="*"/>    <!-- HANG 2: DANH SACH TAI KHOAN -->
        </Grid.RowDefinitions>

        <!-- HANG 0: TIEU DE VA 3 THE KPI NHO GON TRONG 1 HANG -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="QUẢN TRỊ TÀI KHOẢN VÀ PHÂN QUYỀN CÁN BỘ (ADMIN)" FontSize="15" FontWeight="Bold" Foreground="#174A78"/>
                <TextBlock Text="Quản lý thông tin đăng nhập, vai trò và trạng thái khóa/mở khóa tài khoản cán bộ" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- 3 THE KPI THONG KE NHANH (KHONG DUNG ICON) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,6,0" MinWidth="110">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="TỔNG TÀI KHOẢN: " FontSize="10.5" FontWeight="Bold" Foreground="#0369A1" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TongTaiKhoan}" FontSize="13" FontWeight="Bold" Foreground="#0C4A6E" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#DCFCE7" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,6,0" MinWidth="110">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="MỞ KHÓA: " FontSize="10.5" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SoTaiKhoanHoatDong}" FontSize="13" FontWeight="Bold" Foreground="#14532D" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="10,4" MinWidth="100">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ĐÃ KHÓA: " FontSize="10.5" FontWeight="Bold" Foreground="#B91C1C" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SoTaiKhoanBiKhoa}" FontSize="13" FontWeight="Bold" Foreground="#7F1D1D" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- HANG 1: FORM THONG TIN VA CAC NUT THAO TAC -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
            <StackPanel>
                <!-- DONG 1: THONG TIN CO BAN VA TRANG THAI KHOA / MO -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên đăng nhập (*)" FontWeight="SemiBold" FontSize="11.5" Foreground="#1E3A5F" Margin="0,0,0,3"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Vai trò quyền hạn (*)" FontWeight="SemiBold" FontSize="11.5" Foreground="#1E3A5F" Margin="0,0,0,3"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Trạng thái tài khoản (Chọn để Khóa hoặc Mở khóa)" FontWeight="SemiBold" FontSize="11.5" Foreground="#1E3A5F" Margin="0,0,0,3"/>

                    <TextBox Grid.Row="1" Grid.Column="0" Height="28" Padding="6,2" Margin="0,0,8,0" Text="{Binding TenDangNhapNhap, UpdateSourceTrigger=PropertyChanged}" BorderBrush="#CBD5E1" FontSize="12" VerticalContentAlignment="Center"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Height="28" Margin="0,0,8,0" ItemsSource="{Binding DanhSachVaiTro}" SelectedItem="{Binding VaiTroNhap, Mode=TwoWay}" BorderBrush="#CBD5E1" FontSize="12"/>

                    <!-- PHAN CHUYEN TRANG THAI KHOA / MO KHOA (DANG NUT BAM TO, RO RANG) -->
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton GroupName="TrangThaiLockGroup"
                                     Content="MỞ KHÓA (Hoạt động)"
                                     IsChecked="{Binding TrangThaiMoKhoa, Mode=TwoWay}"
                                     Style="{StaticResource MoKhoaRadioBtn}"
                                     ToolTip="Tài khoản được mở khóa và có quyền đăng nhập bình thường"/>

                        <RadioButton GroupName="TrangThaiLockGroup"
                                     Content="ĐÃ KHÓA (Tạm dừng)"
                                     IsChecked="{Binding TrangThaiKhoa, Mode=TwoWay}"
                                     Style="{StaticResource DaKhoaRadioBtn}"
                                     ToolTip="Tài khoản bị khóa, sẽ bị chặn đăng nhập vào hệ thống"/>
                    </StackPanel>
                </Grid>

                <!-- DONG 2: THIET LAP MAT KHAU & GHI CHU -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Mật khẩu tài khoản mới (*)" FontWeight="SemiBold" FontSize="11.5" Foreground="#1E3A5F" Margin="0,0,0,3"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Mật khẩu đặt lại (Reset)" FontWeight="SemiBold" FontSize="11.5" Foreground="#1E3A5F" Margin="0,0,0,3"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Tình trạng áp dụng" FontWeight="SemiBold" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,3"/>

                    <PasswordBox x:Name="MatKhauThemBox" Grid.Row="1" Grid.Column="0" Height="28" Padding="6,2" Margin="0,0,8,0" BorderBrush="#CBD5E1" VerticalContentAlignment="Center"/>
                    <PasswordBox x:Name="MatKhauDatLaiBox" Grid.Row="1" Grid.Column="1" Height="28" Padding="6,2" Margin="0,0,8,0" BorderBrush="#CBD5E1" VerticalContentAlignment="Center"/>

                    <Border Grid.Row="1" Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Height="28" VerticalAlignment="Center" Padding="8,0">
                        <TextBlock Text="{Binding ChuThichTrangThai}" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <TextBlock Text="* Ghi chú: Mật khẩu tối thiểu 6 ký tự. Chỉ cần nhập mật khẩu khi tạo mới hoặc khi nhấn 'ĐẶT LẠI MẬT KHẨU'. Khi chỉnh sửa vai trò hay chuyển đổi Khóa/Mở khóa, không cần nhập lại mật khẩu."
                           FontSize="10.5" Foreground="#64748B" Margin="0,0,0,8"/>

                <!-- DONG 3: CAC NUT HANH DONG CO DIEN GON GANG (BO ICON, KHONG GIU HAN WIDTH DE CHU KHONG BI TRUNCATED) -->
                <WrapPanel>
                    <Button Content="THÊM TÀI KHOẢN" Background="#2E7D32" Style="{StaticResource ClassicBtn}" Click="ThemTaiKhoan_Click" Margin="0,0,6,4"/>
                    <Button Content="CẬP NHẬT" Background="#1976D2" Style="{StaticResource ClassicBtn}" Command="{Binding CapNhatTaiKhoanCommand}" Margin="0,0,6,4"/>
                    <Button Content="ĐẶT LẠI MẬT KHẨU" Background="#D97706" Style="{StaticResource ClassicBtn}" Click="DatLaiMatKhau_Click" Margin="0,0,6,4"/>
                    <Button Content="KHÓA / MỞ NHANH" Background="#7C3AED" Style="{StaticResource ClassicBtn}" Command="{Binding ChuyenTrangThaiKhoaNhanhCommand}" ToolTip="Đảo nhanh trạng thái Khóa / Mở khóa cho tài khoản đang chọn trong bảng" Margin="0,0,6,4"/>
                    <Button Content="LÀM TRỐNG" Background="#64748B" Style="{StaticResource ClassicBtn}" Command="{Binding LamTrongCommand}" Margin="0,0,6,4"/>
                    <Button Content="LÀM MỚI" Background="#0284C7" Style="{StaticResource ClassicBtn}" Command="{Binding LamMoiCommand}" Margin="0,0,6,4"/>
                    <TextBlock Text="{Binding ThongBao}" Foreground="#1976D2" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,4" TextWrapping="Wrap"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- HANG 2: DANH SACH TAI KHOAN -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="DANH SÁCH TÀI KHOẢN TRUY CẬP HỆ THỐNG" FontSize="12.5" FontWeight="Bold" Foreground="#174A78" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="* Mẹo: Nhấp chuột vào một dòng để nạp dữ liệu lên form, hoặc dùng nút 'Khóa / Mở nhanh'" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding DanhSachTaiKhoan}"
                          SelectedItem="{Binding TaiKhoanDuocChon, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          AlternatingRowBackground="#F8FAFC"
                          GridLinesVisibility="Horizontal"
                          RowHeight="30"
                          ColumnHeaderHeight="32"
                          BorderBrush="#CBD5E1"
                          FontSize="11.5"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã TK" Binding="{Binding MaTaiKhoan}" Width="65">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding TenDangNhap}" Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#1E3A5F"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- COT VAI TRO CO BADGE (KHONG DUNG ICON) -->
                        <DataGridTemplateColumn Header="Vai trò quyền hạn" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="11" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VaiTro}" Value="Admin">
                                                        <Setter Property="Background" Value="#EDE9FE"/>
                                                        <Setter Property="BorderBrush" Value="#C4B5FD"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding VaiTroHienThi}" FontWeight="SemiBold" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#475569"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding VaiTro}" Value="Admin">
                                                            <Setter Property="Foreground" Value="#6D28D9"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- COT TRANG THAI KHOA / MO CO BADGE (KHONG DUNG ICON) -->
                        <DataGridTemplateColumn Header="Trạng thái truy cập" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="11" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Setter Property="BorderBrush" Value="#86EFAC"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TrangThai}" Value="False">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                        <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontWeight="Bold" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Mở khóa (Hoạt động)"/>
                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="False">
                                                            <Setter Property="Text" Value="Đã khóa tài khoản"/>
                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Ngày tạo tài khoản" Binding="{Binding NgayTao, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding TrangThaiHienThi}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
