<UserControl x:Class="RESULT_ANALYTICS.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F8">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2">

            <!-- TIEU DE -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="DASHBOARD TỔNG QUAN" FontSize="23" FontWeight="Bold" Foreground="#1E4E79"/>
                    <TextBlock Text="Thống kê dữ liệu kết quả học tập từ SQL Server" FontSize="13" Foreground="#64748B" Margin="0,7,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="LÀM MỚI DỮ LIỆU" Command="{Binding LamMoiCommand}" Background="#1E4E79" Foreground="White" Padding="18,10" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
            </Grid>

            <!-- BON THE KPI -->
            <UniformGrid Columns="4" Margin="0,0,0,20">

                <Border Background="#E3F2FD" CornerRadius="10" Padding="18" Margin="0,0,10,0" MinHeight="120">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TỔNG SINH VIÊN" Foreground="#1E4E79" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TongSinhVien}" Foreground="#1565C0" FontSize="34" FontWeight="Bold" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#E8F5E9" CornerRadius="10" Padding="18" Margin="0,0,10,0" MinHeight="120">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TỔNG LỚP HỌC" Foreground="#2E7D32" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TongLop}" Foreground="#2E7D32" FontSize="34" FontWeight="Bold" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#F3E5F5" CornerRadius="10" Padding="18" Margin="0,0,10,0" MinHeight="120">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TỔNG MÔN HỌC" Foreground="#7B1FA2" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TongMonHoc}" Foreground="#7B1FA2" FontSize="34" FontWeight="Bold" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#FFF3E0" CornerRadius="10" Padding="18" MinHeight="120">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SINH VIÊN THIẾU ĐIỂM" Foreground="#E65100" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SoSinhVienThieuDiem}" Foreground="#E65100" FontSize="34" FontWeight="Bold" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- BANG CANH BAO -->
            <Border Background="White" CornerRadius="10" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="DANH SÁCH SINH VIÊN CẦN BỔ SUNG ĐIỂM" FontSize="17" FontWeight="Bold" Foreground="#1E4E79" Margin="0,0,0,15"/>

                    <DataGrid ItemsSource="{Binding DanhSachCanhBao}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="36" ColumnHeaderHeight="40" Height="270" BorderBrush="#E2E8F0" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8FAFC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã SV" Binding="{Binding MaSV}" Width="75"/>
                            <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="140"/>
                            <DataGridTextColumn Header="Mã môn" Binding="{Binding MaMonHoc}" Width="90"/>
                            <DataGridTextColumn Header="Tên môn học" Binding="{Binding TenMonHoc}" Width="160"/>
                            <DataGridTextColumn Header="Học kỳ" Binding="{Binding MaHocKy}" Width="120"/>
                            <DataGridTextColumn Header="Nội dung cảnh báo" Binding="{Binding NoiDungCanhBao}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="{Binding ThongBao}" Foreground="#64748B" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
