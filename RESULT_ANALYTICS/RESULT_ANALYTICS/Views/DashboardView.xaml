<UserControl x:Class="RESULT_ANALYTICS.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <UserControl.Resources>
        <!-- STYLE NUT CHUNG -->
        <Style x:Key="ClassicBtn" TargetType="Button">
            <Setter Property="Height" Value="29"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE NUT THAO TAC NHANH -->
        <Style x:Key="QuickActionBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F243A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2,0,2,8">

            <!-- TIEU DE VA NUT DONG BO -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="BÀN LÀM VIỆC TỔNG QUAN (EXECUTIVE ACADEMIC DASHBOARD)" FontSize="17" FontWeight="Bold" Foreground="#174A78"/>
                    <TextBlock Text="Trung tâm tổng quan đào tạo: Chỉ số KPI, phân bố học lực, chất lượng học phần &amp; cảnh báo học vụ" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="🔄 ĐỒNG BỘ SỐ LIỆU" Command="{Binding LamMoiCommand}" Background="#1976D2" Style="{StaticResource ClassicBtn}" MinWidth="130" VerticalAlignment="Center"/>
            </Grid>

            <!-- HANG 1: 6 THE CHI SO KPI TOAN DIEN -->
            <UniformGrid Columns="6" Margin="0,0,0,8">

                <!-- 1. TONG SINH VIEN -->
                <Border Background="#E3F2FD" CornerRadius="4" Padding="10,7" Margin="0,0,6,0" BorderBrush="#BBDEFB" BorderThickness="1" MinHeight="72">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="👥 TỔNG SINH VIÊN" Foreground="#1762A5" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TongSinhVien}" Foreground="#174A78" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 2. LOP HOC -->
                <Border Background="#E8F5E9" CornerRadius="4" Padding="10,7" Margin="0,0,6,0" BorderBrush="#C8E6C9" BorderThickness="1" MinHeight="72">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🏫 LỚP SINH HOẠT" Foreground="#2E7D32" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TongLop}" Foreground="#2E7D32" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 3. MON HOC -->
                <Border Background="#F3E5F5" CornerRadius="4" Padding="10,7" Margin="0,0,6,0" BorderBrush="#E1BEE7" BorderThickness="1" MinHeight="72">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="📚 HỌC PHẦN ĐÀO TẠO" Foreground="#7B1FA2" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TongMonHoc}" Foreground="#7B1FA2" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 4. DIEM TB GPA TOAN KHOA -->
                <Border Background="#EEF2FF" CornerRadius="4" Padding="10,7" Margin="0,0,6,0" BorderBrush="#C7D2FE" BorderThickness="1" MinHeight="72">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="📈 ĐIỂM TB TOÀN KHÓA" Foreground="#4338CA" FontSize="10" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding DiemTBChung, StringFormat={}{0:0.00}}" Foreground="#3730A3" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="{Binding GpaHe4HienThi}" Foreground="#4F46E5" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="5,0,0,3"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 5. TY LE DAT CHUNG -->
                <Border Background="#ECFDF5" CornerRadius="4" Padding="10,7" Margin="0,0,6,0" BorderBrush="#A7F3D0" BorderThickness="1" MinHeight="72">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🏆 TỶ LỆ ĐẠT CHUNG" Foreground="#047857" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TyLeDatChung, StringFormat={}{0:0.0}%}" Foreground="#065F46" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 6. THIEU DIEM / CANH BAO -->
                <Border Background="#FFF3E0" CornerRadius="4" Padding="10,7" BorderBrush="#FFE082" BorderThickness="1" MinHeight="72">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="⚠️ CẦN BỔ SUNG ĐIỂM" Foreground="#C46A12" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SoSinhVienThieuDiem}" Foreground="#C46A12" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- HANG 2: HAI KHỐI PHÂN TÍCH CHUYÊN SÂU (PHÂN BỐ HỌC LỰC + KẾT QUẢ THEO HỌC PHẦN) -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4.2*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="5.8*"/>
                </Grid.ColumnDefinitions>

                <!-- COT TRAI: BIEU DO PHAN BO HOC LUC TOAN KHOA -->
                <Border Grid.Column="0" Background="White" CornerRadius="4" Padding="12,10" BorderBrush="#CBD5E1" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📊 PHÂN BỐ HỌC LỰC TOÀN KHÓA" FontSize="12.5" FontWeight="Bold" Foreground="#174A78"/>
                        <TextBlock Text="Tỷ lệ sinh viên theo nhóm phân loại học lực trong học kỳ" FontSize="11" Foreground="#64748B" Margin="0,2,0,8"/>

                        <!-- DANH SACH THANH BAR HOC LUC -->
                        <ItemsControl ItemsSource="{Binding DanhSachPhanBo}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding XepLoai}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                        <Border Grid.Column="1" Background="#F1F5F9" Height="16" CornerRadius="3" VerticalAlignment="Center" Margin="4,0">
                                            <Grid HorizontalAlignment="Left">
                                                <Border Width="{Binding ChieuRongBar}" Height="16" Background="{Binding MauSac}" CornerRadius="3" HorizontalAlignment="Left"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SoLuong}" FontWeight="Bold" FontSize="11.5"/>
                                            <TextBlock Text=" SV " FontSize="10.5" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding TyLe}" FontSize="10.5" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="#F1F5F9" Margin="0,8,0,6"/>
                        <TextBlock Text="💡 Căn cứ theo kết quả trung bình học phần đã chốt điểm." FontSize="10.5" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- COT PHAI: BANG KET QUA DAT / TRUOT THEO HOC PHAN -->
                <Border Grid.Column="2" Background="White" CornerRadius="4" Padding="12,10" BorderBrush="#CBD5E1" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📚 KẾT QUẢ ĐẠT / TRƯỢT THEO HỌC PHẦN" FontSize="12.5" FontWeight="Bold" Foreground="#174A78"/>
                        <TextBlock Text="Tỷ lệ đạt của từng môn học (xếp theo thứ tự cần lưu ý)" FontSize="11" Foreground="#64748B" Margin="0,2,0,8"/>

                        <DataGrid ItemsSource="{Binding DanhSachMonHoc}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="26" ColumnHeaderHeight="28" Height="150" BorderBrush="#CBD5E1" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8FAFC" FontSize="11.5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã môn" Binding="{Binding MaMonHoc}" Width="65"/>
                                <DataGridTextColumn Header="Tên môn học" Binding="{Binding TenMonHoc}" Width="*"/>
                                <DataGridTextColumn Header="Số TC" Binding="{Binding SoTinChi}" Width="50"/>
                                <DataGridTextColumn Header="Tổng SV" Binding="{Binding TongSinhVien}" Width="60"/>
                                <DataGridTextColumn Header="Đạt" Binding="{Binding SoSinhVienDat}" Width="45"/>
                                <DataGridTextColumn Header="Trượt" Binding="{Binding SoSinhVienTruot}" Width="45"/>
                                <DataGridTextColumn Header="Thiếu" Binding="{Binding SoSinhVienThieuDiem}" Width="48"/>
                                <DataGridTextColumn Header="Tỷ lệ Đạt" Binding="{Binding TyLeDat, StringFormat={}{0:0.0}%}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- HANG 3: CANH BAO HOC VU VA THAO TAC NHANH -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6.5*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="3.5*"/>
                </Grid.ColumnDefinitions>

                <!-- COT TRAI: DANH SACH CANH BAO THIEU DIEM CAN XU LY -->
                <Border Grid.Column="0" Background="White" CornerRadius="4" Padding="12,10" BorderBrush="#CBD5E1" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="⚠️ CẢNH BÁO HỌC VỤ &amp; DANH SÁCH CẦN BỔ SUNG ĐIỂM" FontSize="12.5" FontWeight="Bold" Foreground="#C46A12"/>
                        <TextBlock Text="Sinh viên còn thiếu điểm thành phần (chuyên cần, giữa kỳ hoặc cuối kỳ) cần đôn đốc" FontSize="11" Foreground="#64748B" Margin="0,2,0,8"/>

                        <DataGrid ItemsSource="{Binding DanhSachCanhBao}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="26" ColumnHeaderHeight="28" Height="140" BorderBrush="#CBD5E1" GridLinesVisibility="Horizontal" AlternatingRowBackground="#FFF9F5" FontSize="11.5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã SV" Binding="{Binding MaSV}" Width="75"/>
                                <DataGridTextColumn Header="Họ tên sinh viên" Binding="{Binding HoTen}" Width="140"/>
                                <DataGridTextColumn Header="Mã môn" Binding="{Binding MaMonHoc}" Width="70"/>
                                <DataGridTextColumn Header="Tên môn học" Binding="{Binding TenMonHoc}" Width="140"/>
                                <DataGridTextColumn Header="Học kỳ" Binding="{Binding MaHocKy}" Width="95"/>
                                <DataGridTextColumn Header="Nội dung cảnh báo" Binding="{Binding NoiDungCanhBao}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- COT PHAI: THAO TAC NHANH VA TRANG THAI HE THONG -->
                <Border Grid.Column="2" Background="White" CornerRadius="4" Padding="12,10" BorderBrush="#CBD5E1" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="⚡ LỐI TẮT THAO TÁC NHANH" FontSize="12.5" FontWeight="Bold" Foreground="#174A78"/>
                        <TextBlock Text="Truy cập nhanh các phân hệ nghiệp vụ thường dùng" FontSize="11" Foreground="#64748B" Margin="0,2,0,8"/>

                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button Content="📝 Sổ điểm học phần" Style="{StaticResource QuickActionBtn}" Command="{Binding ChuyenDenNhapDiemCommand}"/>
                            <Button Content="📥 Nhập file Excel/CSV" Style="{StaticResource QuickActionBtn}" Command="{Binding ChuyenDenImportCommand}"/>
                            <Button Content="👨‍🎓 Hồ sơ Sinh viên" Style="{StaticResource QuickActionBtn}" Command="{Binding ChuyenDenSinhVienCommand}"/>
                            <Button Content="📈 Báo cáo GPA &amp; Lực" Style="{StaticResource QuickActionBtn}" Command="{Binding ChuyenDenPhanTichCommand}"/>
                        </UniformGrid>

                        <!-- THE TRANG THAI DU LIEU -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="{Binding HeThongDbHienThi}" FontSize="11" FontWeight="SemiBold" Foreground="#0F243A"/>
                                <TextBlock Text="{Binding NienKhoaHienThi}" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding ThongBao}" FontSize="10.5" Foreground="#1976D2" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>