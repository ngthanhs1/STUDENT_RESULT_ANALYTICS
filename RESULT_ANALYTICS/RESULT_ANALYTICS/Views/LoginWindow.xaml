<Window x:Class="RESULT_ANALYTICS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập hệ thống" Height="450" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F4F6F8">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- TIEU DE -->
        <Border Grid.Row="0" Background="#1E4E79" CornerRadius="8">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="STUDENT RESULT ANALYTICS" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="HỆ THỐNG PHÂN TÍCH KẾT QUẢ HỌC TẬP" Foreground="#DCE9F5" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- FORM DANG NHAP -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8" Margin="0,15,0,10" Padding="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Tên đăng nhập" FontSize="14" FontWeight="SemiBold"/>
                <TextBox x:Name="txtTenDangNhap" Height="38" Margin="0,8,0,16" Padding="8" FontSize="14" Text="{Binding TenDangNhap, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Mật khẩu" FontSize="14" FontWeight="SemiBold"/>
                <PasswordBox x:Name="txtMatKhau" Height="38" Margin="0,8,0,10" Padding="8" FontSize="14" KeyDown="TxtMatKhau_KeyDown"/>

                <TextBlock Text="{Binding ThongBao}" Foreground="#D32F2F" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- HAI NUT -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnDangNhap" Grid.Column="0" Content="ĐĂNG NHẬP" Height="42" Background="#1E4E79" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Click="BtnDangNhap_Click"/>
            <Button x:Name="btnThoat" Grid.Column="2" Content="THOÁT" Height="42" Background="#D9534F" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Click="BtnThoat_Click"/>
        </Grid>
    </Grid>
</Window>
