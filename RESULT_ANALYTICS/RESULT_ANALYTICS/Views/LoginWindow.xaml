<Window x:Class="RESULT_ANALYTICS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập hệ thống - Student Result Analytics"
        Height="740" Width="1240"
        MinHeight="620" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#0D274D">

    <Grid>
        <!-- 1. ANH NEN SINH VIEN TOT NGHIEP (COVER TOAN BO MAN HINH) -->
        <Image Source="/Assets/bg_login.jpg" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- 2. LOP PHU GRADIENT DE TAO DO CHIEU SAU -->
        <Border Background="#1A0D274D"/>

        <!-- 3. HOP DANG NHAP TRUNG TAM (KICH THUOC TO, RO NET, DE NHIN) -->
        <Border Width="460" Background="#EDF2FD" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="38,26,38,32">
            <!-- DO BONG MEM MAI -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="35" ShadowDepth="5" Direction="270" Color="#000000" Opacity="0.45"/>
            </Border.Effect>

            <StackPanel>
                <!-- ANH MAY BAY GIAY DUONG LUON (KICH THUOC LON HON) -->
                <Image Source="/Assets/paper_plane.png" Width="250" Height="80" HorizontalAlignment="Center" Margin="0,-6,0,6" Stretch="Uniform"/>

                <!-- TIEU DE DANG NHAP -->
                <TextBlock Text="ĐĂNG NHẬP" FontSize="22" FontWeight="Bold" Foreground="#1E3A8A" HorizontalAlignment="Center"/>

                <!-- CHU GIOI THIEU VE HE THONG NGAY DUOI TEXT DANG NHAP -->
                <TextBlock Text="HỆ THỐNG PHÂN TÍCH KẾT QUẢ HỌC TẬP" FontSize="12" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" Margin="0,5,0,18"/>

                <!-- KHUNG THONG BAO LOI TRUC QUAN (XUAT HIEN KHI NHAP SAI HOAC THIEU) -->
                <Border Background="#FEE2E2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CoLoi}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ThongBao}" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- TRUONG NHAP 1: TAI KHOAN HOAC EMAIL (CAO 44PX, CHU 14PX) -->
                <Border Background="White" CornerRadius="8" Height="44" Margin="0,0,0,12" BorderBrush="#CBD5E1" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="👤" FontSize="15" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtTenDangNhap" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="13.5" VerticalContentAlignment="Center" Padding="2,0,10,0" Text="{Binding TenDangNhap, UpdateSourceTrigger=PropertyChanged}" KeyDown="TxtTenDangNhap_KeyDown"/>
                    </Grid>
                </Border>

                <!-- TRUONG NHAP 2: MAT KHAU (CAO 44PX, CHU 14PX) -->
                <Border Background="White" CornerRadius="8" Height="44" Margin="0,0,0,10" BorderBrush="#CBD5E1" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔑" FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="txtMatKhau" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="13.5" VerticalContentAlignment="Center" Padding="2,0,4,0" KeyDown="TxtMatKhau_KeyDown" PasswordChanged="TxtMatKhau_PasswordChanged"/>
                        <TextBox x:Name="txtMatKhauHienThi" Grid.Column="1" Visibility="Collapsed" BorderThickness="0" Background="Transparent" FontSize="13.5" VerticalContentAlignment="Center" Padding="2,0,4,0" KeyDown="TxtMatKhau_KeyDown" TextChanged="TxtMatKhauHienThi_TextChanged"/>
                        <Button x:Name="btnToggleMatKhau" Grid.Column="2" Click="BtnToggleMatKhau_Click" BorderThickness="0" Cursor="Hand" ToolTip="Hiện / Ẩn mật khẩu" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" Padding="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock x:Name="txtIconMatKhau" Text="👁" FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- DONG HO TRO: QUEN MAT KHAU & TRO GIUP -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Quên mật khẩu" FontSize="12" Foreground="#475569" Cursor="Hand" MouseLeftButtonDown="QuenMatKhau_Click"/>
                    <TextBlock Grid.Column="1" Text="❓ Trợ giúp!" FontSize="12" Foreground="#475569" HorizontalAlignment="Right" Cursor="Hand" MouseLeftButtonDown="TroGiup_Click"/>
                </Grid>

                <!-- NUT DANG NHAP CHINH (CAO 44PX, CHU IN HOA DAM 14.5PX) -->
                <Button x:Name="btnDangNhap" Height="44" Background="#1E3A8A" Foreground="White" FontWeight="Bold" FontSize="14.5" BorderThickness="0" Cursor="Hand" Click="BtnDangNhap_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                                <TextBlock Text="ĐĂNG NHẬP" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#172554"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#0F172A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- LINK THOAT UNG DUNG -->
                <TextBlock Text="Thoát ứng dụng" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,16,0,0" Cursor="Hand" MouseLeftButtonDown="Thoat_Click">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                    <Setter Property="TextDecorations" Value="Underline"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </StackPanel>
        </Border>
    </Grid>
</Window>
