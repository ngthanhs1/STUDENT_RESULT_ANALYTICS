<UserControl x:Class="RESULT_ANALYTICS.Views.QuanLyDiemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F8">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="3">

            <!-- TIEU DE -->
            <TextBlock Text="NHẬP VÀ QUẢN LÝ ĐIỂM" Foreground="#174A78" FontSize="23" FontWeight="Bold"/>
            <TextBlock Text="Quản lý kết quả học tập của sinh viên theo môn học và học kỳ" Foreground="#64748B" FontSize="12" Margin="0,5,0,0"/>

            <!-- FORM NHAP DIEM -->
            <Border Background="White" CornerRadius="8" Padding="20" Margin="0,20,0,15" BorderBrush="#DDE5EF" BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="THÔNG TIN KẾT QUẢ HỌC TẬP" FontSize="16" FontWeight="Bold" Foreground="#174A78"/>

                    <Grid Margin="0,15,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- NHAN THONG TIN -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sinh viên (*)" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Môn học (*)" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Học kỳ (*)" FontWeight="SemiBold" FontSize="12"/>

                        <!-- CHON SINH VIEN -->
                        <ComboBox Grid.Row="1" Grid.Column="0" Height="35" Margin="0,6,10,0" ItemsSource="{Binding DanhSachSinhVien}" SelectedValuePath="MaSV" SelectedValue="{Binding MaSVNhap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding MaSV}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding HoTen}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- CHON MON HOC -->
                        <ComboBox Grid.Row="1" Grid.Column="1" Height="35" Margin="0,6,10,0" ItemsSource="{Binding DanhSachMonHoc}" SelectedValuePath="MaMonHoc" SelectedValue="{Binding MaMonHocNhap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding MaMonHoc}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding TenMonHoc}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- CHON HOC KY -->
                        <ComboBox Grid.Row="1" Grid.Column="2" Height="35" Margin="0,6,0,0" ItemsSource="{Binding DanhSachHocKy}" SelectedValuePath="MaHocKy" SelectedValue="{Binding MaHocKyNhap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding MaHocKy}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding TenHocKy}" Margin="0,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- NHAN DIEM -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Điểm chuyên cần (10%)" FontWeight="SemiBold" FontSize="12" Margin="0,20,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Điểm giữa kỳ (30%)" FontWeight="SemiBold" FontSize="12" Margin="0,20,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Điểm cuối kỳ (60%)" FontWeight="SemiBold" FontSize="12" Margin="0,20,0,0"/>

                        <!-- NHAP DIEM -->
                        <TextBox Grid.Row="3" Grid.Column="0" Height="35" Margin="0,6,10,0" Padding="8,5" Text="{Binding DiemChuyenCanNhap, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Height="35" Margin="0,6,10,0" Padding="8,5" Text="{Binding DiemGiuaKyNhap, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Grid.Row="3" Grid.Column="2" Height="35" Margin="0,6,0,0" Padding="8,5" Text="{Binding DiemCuoiKyNhap, UpdateSourceTrigger=PropertyChanged}"/>

                    </Grid>

                    <!-- GHI CHU -->
                    <TextBlock Text="Lưu ý: Điểm từ 0 đến 10. Có thể để trống điểm chưa có. Điểm tổng kết được SQL Server tự tính." Foreground="#64748B" FontSize="12" Margin="0,15,0,0" TextWrapping="Wrap"/>

                    <!-- CAC NUT CHUC NANG -->
                    <WrapPanel Margin="0,20,0,0">

                        <Button Content="THÊM ĐIỂM" Width="120" Height="38" Margin="0,0,8,8" Background="#27813C" Foreground="White" FontWeight="Bold" BorderThickness="0" Command="{Binding ThemDiemCommand}"/>
                        <Button Content="SỬA ĐIỂM" Width="120" Height="38" Margin="0,0,8,8" Background="#1976D2" Foreground="White" FontWeight="Bold" BorderThickness="0" Command="{Binding SuaDiemCommand}"/>
                        <Button Content="XÓA ĐIỂM" Width="120" Height="38" Margin="0,0,8,8" Background="#D32F2F" Foreground="White" FontWeight="Bold" BorderThickness="0" Command="{Binding XoaDiemCommand}"/>
                        <Button Content="LÀM TRỐNG" Width="120" Height="38" Margin="0,0,8,8" Background="#64748B" Foreground="White" FontWeight="Bold" BorderThickness="0" Command="{Binding LamTrongCommand}"/>
                        <Button Content="LÀM MỚI" Width="120" Height="38" Margin="0,0,8,8" Background="#00889A" Foreground="White" FontWeight="Bold" BorderThickness="0" Command="{Binding LamMoiCommand}"/>

                    </WrapPanel>

                    <!-- THONG BAO -->
                    <TextBlock Text="{Binding ThongBao}" Foreground="#1976D2" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>

                </StackPanel>

            </Border>

            <!-- DANH SACH KET QUA -->
            <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20" BorderBrush="#DDE5EF" BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="DANH SÁCH KẾT QUẢ HỌC TẬP" FontSize="16" FontWeight="Bold" Foreground="#174A78" Margin="0,0,0,15"/>

                    <DataGrid ItemsSource="{Binding DanhSachKetQua}" SelectedItem="{Binding KetQuaDuocChon, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AlternatingRowBackground="#EEF3F9" RowHeight="32" ColumnHeaderHeight="35" Height="350">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Mã KQ" Binding="{Binding MaKetQua}" Width="65"/>
                            <DataGridTextColumn Header="Mã SV" Binding="{Binding MaSV}" Width="85"/>
                            <DataGridTextColumn Header="Họ tên sinh viên" Binding="{Binding HoTen}" Width="160"/>
                            <DataGridTextColumn Header="Mã môn" Binding="{Binding MaMonHoc}" Width="85"/>
                            <DataGridTextColumn Header="Tên môn học" Binding="{Binding TenMonHoc}" Width="165"/>
                            <DataGridTextColumn Header="Học kỳ" Binding="{Binding TenHocKy}" Width="105"/>
                            <DataGridTextColumn Header="Chuyên cần" Binding="{Binding DiemChuyenCan}" Width="95"/>
                            <DataGridTextColumn Header="Giữa kỳ" Binding="{Binding DiemGiuaKy}" Width="85"/>
                            <DataGridTextColumn Header="Cuối kỳ" Binding="{Binding DiemCuoiKy}" Width="85"/>
                            <DataGridTextColumn Header="Tổng kết" Binding="{Binding DiemTongKet}" Width="95"/>

                        </DataGrid.Columns>

                    </DataGrid>

                    <TextBlock Text="Chọn một dòng trong bảng để sửa hoặc xóa điểm. Có thể kéo thanh cuộn ngang để xem các cột." Foreground="#64748B" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
