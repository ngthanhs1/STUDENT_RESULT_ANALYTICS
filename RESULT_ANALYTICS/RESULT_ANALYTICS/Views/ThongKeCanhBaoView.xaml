<UserControl x:Class="RESULT_ANALYTICS.Views.ThongKeCanhBaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F8">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="3">

            <!-- ====================================== -->
            <!-- TIEU DE -->
            <!-- ====================================== -->

            <TextBlock Text="THỐNG KÊ VÀ CẢNH BÁO" FontSize="23" FontWeight="Bold" Foreground="#174A78"/>
            <TextBlock Text="Theo dõi kết quả đạt, trượt và cảnh báo sinh viên thiếu điểm" FontSize="12" Foreground="#64748B" Margin="0,5,0,0" TextWrapping="Wrap"/>

            <!-- ====================================== -->
            <!-- BO LOC THONG KE -->
            <!-- ====================================== -->

            <Border Background="White" CornerRadius="8" Padding="20" Margin="0,20,0,15" BorderBrush="#DDE5EF" BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="BỘ LỌC THỐNG KÊ" FontSize="16" FontWeight="Bold" Foreground="#174A78"/>

                    <Grid Margin="0,15,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Chọn môn học" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Chọn học kỳ" FontWeight="SemiBold" FontSize="12"/>

                        <ComboBox Grid.Row="1" Grid.Column="0" Height="36" Margin="0,7,12,0" ItemsSource="{Binding DanhSachMonHocLoc}" DisplayMemberPath="TenHienThi" SelectedValuePath="Ma" SelectedValue="{Binding MaMonHocLoc, Mode=TwoWay}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Height="36" Margin="0,7,0,0" ItemsSource="{Binding DanhSachHocKyLoc}" DisplayMemberPath="TenHienThi" SelectedValuePath="Ma" SelectedValue="{Binding MaHocKyLoc, Mode=TwoWay}"/>

                    </Grid>

                    <WrapPanel Margin="0,18,0,0">
                        <Button Content="LỌC DỮ LIỆU" Width="140" Height="38" Margin="0,0,10,5" Background="#1976D2" Foreground="White" FontWeight="Bold" BorderThickness="0" Command="{Binding LocDuLieuCommand}"/>
                        <Button Content="LÀM MỚI" Width="125" Height="38" Margin="0,0,10,5" Background="#00889A" Foreground="White" FontWeight="Bold" BorderThickness="0" Command="{Binding LamMoiCommand}"/>
                    </WrapPanel>

                    <TextBlock Text="{Binding ThongBao}" Foreground="#1976D2" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>

                </StackPanel>

            </Border>

            <!-- ====================================== -->
            <!-- THONG KE TONG QUAN -->
            <!-- ====================================== -->

            <TextBlock Text="THỐNG KÊ TỔNG QUAN" FontSize="16" FontWeight="Bold" Foreground="#174A78" Margin="0,5,0,12"/>

            <WrapPanel Margin="0,0,0,15">

                <!-- TONG LUOT KET QUA -->
                <Border Width="180" Height="105" Background="#E3F2FD" CornerRadius="8" Padding="15" Margin="0,0,12,10">
                    <StackPanel>
                        <TextBlock Text="TỔNG LƯỢT KẾT QUẢ" FontSize="11" FontWeight="SemiBold" Foreground="#1762A5"/>
                        <TextBlock Text="{Binding TongLuotKetQua}" FontSize="30" FontWeight="Bold" Foreground="#174A78" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- LUOT DAT -->
                <Border Width="180" Height="105" Background="#E7F5E9" CornerRadius="8" Padding="15" Margin="0,0,12,10">
                    <StackPanel>
                        <TextBlock Text="LƯỢT ĐẠT" FontSize="11" FontWeight="SemiBold" Foreground="#287D3C"/>
                        <TextBlock Text="{Binding TongLuotDat}" FontSize="30" FontWeight="Bold" Foreground="#287D3C" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- LUOT TRUOT -->
                <Border Width="180" Height="105" Background="#FDE8E8" CornerRadius="8" Padding="15" Margin="0,0,12,10">
                    <StackPanel>
                        <TextBlock Text="LƯỢT TRƯỢT" FontSize="11" FontWeight="SemiBold" Foreground="#C62828"/>
                        <TextBlock Text="{Binding TongLuotTruot}" FontSize="30" FontWeight="Bold" Foreground="#C62828" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- LUOT THIEU DIEM -->
                <Border Width="180" Height="105" Background="#FFF0E0" CornerRadius="8" Padding="15" Margin="0,0,12,10">
                    <StackPanel>
                        <TextBlock Text="LƯỢT THIẾU ĐIỂM" FontSize="11" FontWeight="SemiBold" Foreground="#C46A12"/>
                        <TextBlock Text="{Binding TongLuotThieuDiem}" FontSize="30" FontWeight="Bold" Foreground="#C46A12" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- TY LE DAT -->
                <Border Width="180" Height="105" Background="#F1E7F8" CornerRadius="8" Padding="15" Margin="0,0,12,10">
                    <StackPanel>
                        <TextBlock Text="TỶ LỆ ĐẠT CHUNG" FontSize="11" FontWeight="SemiBold" Foreground="#803DB0"/>
                        <TextBlock Text="{Binding TyLeDatChung}" FontSize="27" FontWeight="Bold" Foreground="#803DB0" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- SO CANH BAO -->
                <Border Width="180" Height="105" Background="#FFF3CD" CornerRadius="8" Padding="15" Margin="0,0,12,10">
                    <StackPanel>
                        <TextBlock Text="SỐ CẢNH BÁO" FontSize="11" FontWeight="SemiBold" Foreground="#9B6A00"/>
                        <TextBlock Text="{Binding SoCanhBao}" FontSize="30" FontWeight="Bold" Foreground="#9B6A00" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </WrapPanel>

            <!-- ====================================== -->
            <!-- BIEU DO COT DOC DAT / TRUOT / THIEU -->
            <!-- ====================================== -->

            <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15" BorderBrush="#DDE5EF" BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="BIỂU ĐỒ CỘT KẾT QUẢ ĐẠT / TRƯỢT" FontSize="16" FontWeight="Bold" Foreground="#174A78"/>
                    <TextBlock Text="So sánh số lượt đạt, trượt và thiếu điểm của từng môn học theo học kỳ" FontSize="12" Foreground="#64748B" Margin="0,5,0,15" TextWrapping="Wrap"/>

                    <!-- CHU THICH MAU -->
                    <WrapPanel Margin="0,0,0,15">

                        <StackPanel Orientation="Horizontal" Margin="0,0,22,5">
                            <Border Width="15" Height="15" Background="#27813C" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="Đạt" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,22,5">
                            <Border Width="15" Height="15" Background="#D32F2F" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="Trượt" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,22,5">
                            <Border Width="15" Height="15" Background="#E69A28" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="Thiếu điểm" FontSize="12"/>
                        </StackPanel>

                    </WrapPanel>

                    <!-- COT DOC, CUON NGANG KHI CO NHIEU MON -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">

                        <ItemsControl ItemsSource="{Binding DanhSachBieuDo}">

                            <!-- MOI MON HOC NAM CANH NHAU -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Width="220" Margin="0,0,14,0" Padding="7,5" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">

                                        <StackPanel>

                                            <!-- BA COT CUNG MOC CHAN -->
                                            <Grid Height="285">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- COT DAT -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding SoDat}" FontSize="12" FontWeight="Bold" Foreground="#27813C" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                    <Border Width="38" Height="{Binding ChieuRongDat}" Background="#27813C" CornerRadius="4,4,0,0" VerticalAlignment="Bottom"/>
                                                </StackPanel>

                                                <!-- COT TRUOT -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding SoTruot}" FontSize="12" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                    <Border Width="38" Height="{Binding ChieuRongTruot}" Background="#D32F2F" CornerRadius="4,4,0,0" VerticalAlignment="Bottom"/>
                                                </StackPanel>

                                                <!-- COT THIEU DIEM -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding SoThieuDiem}" FontSize="12" FontWeight="Bold" Foreground="#C46A12" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                    <Border Width="38" Height="{Binding ChieuRongThieuDiem}" Background="#E69A28" CornerRadius="4,4,0,0" VerticalAlignment="Bottom"/>
                                                </StackPanel>

                                            </Grid>

                                            <!-- TRUC NGANG -->
                                            <Border Height="1" Background="#CBD5E1" Margin="0,0,0,7"/>

                                            <!-- NHAN TUNG COT -->
                                            <Grid Margin="0,0,0,12">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="Đạt" FontSize="11" Foreground="#27813C" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Trượt" FontSize="11" Foreground="#D32F2F" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="Thiếu" FontSize="11" Foreground="#C46A12" HorizontalAlignment="Center"/>

                                            </Grid>

                                            <!-- TEN MON HOC VA HOC KY -->
                                            <TextBlock Text="{Binding TenNhom}" FontSize="12" FontWeight="SemiBold" Foreground="#174A78" TextAlignment="Center" TextWrapping="Wrap" MinHeight="50" ToolTip="{Binding TenNhom}"/>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                    <TextBlock Text="Mỗi nhóm gồm 3 cột đứng: Đạt (xanh), Trượt (đỏ), Thiếu điểm (cam). Chiều cao cột biểu thị số lượt tương ứng." FontSize="12" Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap"/>

                </StackPanel>

            </Border>

            <!-- ====================================== -->
            <!-- BANG THONG KE DAT VA TRUOT -->
            <!-- ====================================== -->

            <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15" BorderBrush="#DDE5EF" BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="BẢNG THỐNG KÊ ĐẠT VÀ TRƯỢT" FontSize="16" FontWeight="Bold" Foreground="#174A78" Margin="0,0,0,15"/>

                    <DataGrid ItemsSource="{Binding DanhSachThongKe}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AlternatingRowBackground="#EEF3F9" RowHeight="32" ColumnHeaderHeight="35" Height="260" HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Mã môn" Binding="{Binding MaMonHoc}" Width="90"/>
                            <DataGridTextColumn Header="Tên môn học" Binding="{Binding TenMonHoc}" Width="165"/>
                            <DataGridTextColumn Header="Số tín chỉ" Binding="{Binding SoTinChi}" Width="85"/>
                            <DataGridTextColumn Header="Học kỳ" Binding="{Binding TenHocKy}" Width="100"/>
                            <DataGridTextColumn Header="Năm học" Binding="{Binding NamHoc}" Width="105"/>
                            <DataGridTextColumn Header="Tổng SV" Binding="{Binding TongSinhVien}" Width="85"/>
                            <DataGridTextColumn Header="SV đạt" Binding="{Binding SoSinhVienDat}" Width="85"/>
                            <DataGridTextColumn Header="SV trượt" Binding="{Binding SoSinhVienTruot}" Width="90"/>
                            <DataGridTextColumn Header="SV thiếu điểm" Binding="{Binding SoSinhVienThieuDiem}" Width="115"/>
                            <DataGridTextColumn Header="Tỷ lệ đạt (%)" Binding="{Binding TyLeDat, StringFormat={}{0:0.00}}" Width="120"/>

                        </DataGrid.Columns>

                    </DataGrid>

                    <TextBlock Text="Tỷ lệ đạt của từng môn được lấy từ VIEW thống kê trong SQL Server và tính trên các kết quả đã đủ điểm." FontSize="12" Foreground="#64748B" Margin="0,12,0,0" TextWrapping="Wrap"/>

                </StackPanel>

            </Border>

            <!-- ====================================== -->
            <!-- BANG CANH BAO THIEU DIEM -->
            <!-- ====================================== -->

            <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20" BorderBrush="#DDE5EF" BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="DANH SÁCH SINH VIÊN CẦN BỔ SUNG ĐIỂM" FontSize="16" FontWeight="Bold" Foreground="#174A78" Margin="0,0,0,15"/>

                    <DataGrid ItemsSource="{Binding DanhSachCanhBao}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AlternatingRowBackground="#FFF5E9" RowHeight="32" ColumnHeaderHeight="35" Height="260" HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Mã SV" Binding="{Binding MaSV}" Width="90"/>
                            <DataGridTextColumn Header="Họ tên sinh viên" Binding="{Binding HoTen}" Width="175"/>
                            <DataGridTextColumn Header="Mã môn" Binding="{Binding MaMonHoc}" Width="90"/>
                            <DataGridTextColumn Header="Tên môn học" Binding="{Binding TenMonHoc}" Width="165"/>
                            <DataGridTextColumn Header="Học kỳ" Binding="{Binding TenHocKy}" Width="100"/>
                            <DataGridTextColumn Header="Năm học" Binding="{Binding NamHoc}" Width="100"/>
                            <DataGridTextColumn Header="Chuyên cần" Binding="{Binding DiemChuyenCan}" Width="95"/>
                            <DataGridTextColumn Header="Giữa kỳ" Binding="{Binding DiemGiuaKy}" Width="90"/>
                            <DataGridTextColumn Header="Cuối kỳ" Binding="{Binding DiemCuoiKy}" Width="90"/>
                            <DataGridTextColumn Header="Nội dung cảnh báo" Binding="{Binding NoiDungCanhBao}" Width="210"/>

                        </DataGrid.Columns>

                    </DataGrid>

                    <TextBlock Text="Các ô điểm trống biểu thị dữ liệu NULL trong SQL Server. Hãy mở chức năng 04 để bổ sung điểm." FontSize="12" Foreground="#C46A12" Margin="0,12,0,0" TextWrapping="Wrap"/>

                </StackPanel>

            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
