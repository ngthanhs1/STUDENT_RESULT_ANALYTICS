<UserControl x:Class="RESULT_ANALYTICS.Views.ThongKeCanhBaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <!-- DINH DANG GIAO DIEN CO DIEN GON GANG -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ClassicBtn" TargetType="Button">
            <Setter Property="Height" Value="27"/>
            <Setter Property="MinWidth" Value="75"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineSmallBtn" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1E4E79"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClassicTab" TargetType="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Background="#E2E8F0" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}" BorderBrush="#CBD5E1" BorderThickness="1,1,1,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#174A78"/>
                                <Setter TargetName="tabBorder" Property="BorderThickness" Value="1,2,1,0"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#1E4E79"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="2,0,2,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- HANG 0: TIEU DE -->
            <RowDefinition Height="Auto"/> <!-- HANG 1: BO LOC GIAO DIEN -->
            <RowDefinition Height="Auto"/> <!-- HANG 2: 6 THE CHI SO DONG DEU -->
            <RowDefinition Height="*"/>    <!-- HANG 3: TAB DU LIEU CHI TIET -->
        </Grid.RowDefinitions>

        <!-- HANG 0: TIEU DE -->
        <TextBlock Grid.Row="0" Text="THỐNG KÊ ĐẠT / TRƯỢT &amp; CẢNH BÁO HỌC VỤ" FontSize="16" FontWeight="Bold" Foreground="#174A78" Margin="0,0,0,6"/>

        <!-- HANG 1: THANH BO LOC GON GANG TREN 1 HANG -->
        <Border Grid.Row="1" Background="White" CornerRadius="4" Padding="10,6" Margin="0,0,0,6" BorderBrush="#CBD5E1" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- "Môn học:" -->
                    <ColumnDefinition Width="220"/> <!-- ComboBox Mon hoc -->
                    <ColumnDefinition Width="Auto"/> <!-- "Học kỳ:" -->
                    <ColumnDefinition Width="180"/> <!-- ComboBox Hoc ky -->
                    <ColumnDefinition Width="Auto"/> <!-- Button Loc -->
                    <ColumnDefinition Width="Auto"/> <!-- Button Lam moi -->
                    <ColumnDefinition Width="*"/>    <!-- Thong bao -->
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Môn học:" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="1" Height="27" Margin="0,0,12,0" ItemsSource="{Binding DanhSachMonHocLoc}" DisplayMemberPath="TenHienThi" SelectedValuePath="Ma" SelectedValue="{Binding MaMonHocLoc, Mode=TwoWay}" FontSize="11.5"/>

                <TextBlock Grid.Column="2" Text="Học kỳ:" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="3" Height="27" Margin="0,0,12,0" ItemsSource="{Binding DanhSachHocKyLoc}" DisplayMemberPath="TenHienThi" SelectedValuePath="Ma" SelectedValue="{Binding MaHocKyLoc, Mode=TwoWay}" FontSize="11.5"/>

                <Button Grid.Column="4" Content="LỌC DỮ LIỆU" Command="{Binding LocDuLieuCommand}" Background="#1976D2" Style="{StaticResource ClassicBtn}" MinWidth="85" Margin="0,0,6,0"/>
                <Button Grid.Column="5" Content="LÀM MỚI" Command="{Binding LamMoiCommand}" Background="#0284C7" Style="{StaticResource ClassicBtn}" MinWidth="75" Margin="0,0,10,0"/>

                <TextBlock Grid.Column="6" Text="{Binding ThongBao}" Foreground="#1976D2" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- HANG 2: 6 THE THONG KE NẰM GỌN TREN 1 HANG (UNIFORMGRID) -->
        <UniformGrid Grid.Row="2" Columns="6" Margin="0,0,0,6">
            <!-- 1. TONG KET QUA -->
            <Border Background="#E3F2FD" CornerRadius="4" Padding="10,5" Margin="0,0,4,0" BorderBrush="#BBDEFB" BorderThickness="1" MinHeight="58">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📊 TỔNG KẾT QUẢ" FontSize="10" FontWeight="SemiBold" Foreground="#1762A5"/>
                    <TextBlock Text="{Binding TongLuotKetQua}" FontSize="18" FontWeight="Bold" Foreground="#174A78" Margin="0,1,0,0"/>
                </StackPanel>
            </Border>

            <!-- 2. LUOT DAT -->
            <Border Background="#E8F5E9" CornerRadius="4" Padding="10,5" Margin="2,0,4,0" BorderBrush="#C8E6C9" BorderThickness="1" MinHeight="58">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="✅ LƯỢT ĐẠT" FontSize="10" FontWeight="SemiBold" Foreground="#2E7D32"/>
                    <TextBlock Text="{Binding TongLuotDat}" FontSize="18" FontWeight="Bold" Foreground="#2E7D32" Margin="0,1,0,0"/>
                </StackPanel>
            </Border>

            <!-- 3. LUOT TRUOT -->
            <Border Background="#FDE8E8" CornerRadius="4" Padding="10,5" Margin="2,0,4,0" BorderBrush="#FFCDD2" BorderThickness="1" MinHeight="58">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="❌ LƯỢT TRƯỢT" FontSize="10" FontWeight="SemiBold" Foreground="#C62828"/>
                    <TextBlock Text="{Binding TongLuotTruot}" FontSize="18" FontWeight="Bold" Foreground="#C62828" Margin="0,1,0,0"/>
                </StackPanel>
            </Border>

            <!-- 4. THIEU DIEM -->
            <Border Background="#FFF3E0" CornerRadius="4" Padding="10,5" Margin="2,0,4,0" BorderBrush="#FFE0B2" BorderThickness="1" MinHeight="58">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="⏳ THIẾU ĐIỂM" FontSize="10" FontWeight="SemiBold" Foreground="#C46A12"/>
                    <TextBlock Text="{Binding TongLuotThieuDiem}" FontSize="18" FontWeight="Bold" Foreground="#C46A12" Margin="0,1,0,0"/>
                </StackPanel>
            </Border>

            <!-- 5. TY LE DAT -->
            <Border Background="#F3E8FF" CornerRadius="4" Padding="10,5" Margin="2,0,4,0" BorderBrush="#E1BEE7" BorderThickness="1" MinHeight="58">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📈 TỶ LỆ ĐẠT" FontSize="10" FontWeight="SemiBold" Foreground="#7E22CE"/>
                    <TextBlock Text="{Binding TyLeDatChung}" FontSize="18" FontWeight="Bold" Foreground="#6B21A8" Margin="0,1,0,0"/>
                </StackPanel>
            </Border>

            <!-- 6. CANH BAO -->
            <Border Background="#FEF3C7" CornerRadius="4" Padding="10,5" Margin="2,0,0,0" BorderBrush="#FDE68A" BorderThickness="1" MinHeight="58">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🚨 CẢNH BÁO" FontSize="10" FontWeight="SemiBold" Foreground="#B45309"/>
                    <TextBlock Text="{Binding SoCanhBao}" FontSize="18" FontWeight="Bold" Foreground="#92400E" Margin="0,1,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- HANG 3: TABCONTROL CHIA 2 MỤC THÔNG MINH, KHÔNG CẦN CUỘN TRANG DÀI -->
        <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0" Margin="0,2,0,0">
            <!-- TAB 1: THONG KE MON HOC & BIEU DO -->
            <TabItem Style="{StaticResource ClassicTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊 Thống kê môn học &amp; Biểu đồ" VerticalAlignment="Center"/>
                        <Border Background="#1E4E79" CornerRadius="7" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DanhSachThongKe.Count}" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>

                <Border Background="White" CornerRadius="0,4,4,4" Padding="10" BorderBrush="#CBD5E1" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- KHUNG BIEU DO -->
                            <RowDefinition Height="*"/>    <!-- BANG THONG KE CHI TIET -->
                        </Grid.RowDefinitions>

                        <!-- KHUNG BIEU DO THU GON (CO NUT AN/HIEN) -->
                        <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="4" Padding="10,6" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="BIỂU ĐỒ CỘT ĐẠT / TRƯỢT THEO HỌC PHẦN" FontSize="12" FontWeight="Bold" Foreground="#174A78" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                        <!-- CHU THICH MAU -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Border Width="10" Height="10" Background="#27813C" CornerRadius="2" Margin="0,0,4,0"/>
                                            <TextBlock Text="Đạt" FontSize="11" Foreground="#334155"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Border Width="10" Height="10" Background="#D32F2F" CornerRadius="2" Margin="0,0,4,0"/>
                                            <TextBlock Text="Trượt" FontSize="11" Foreground="#334155"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Border Width="10" Height="10" Background="#E69A28" CornerRadius="2" Margin="0,0,4,0"/>
                                            <TextBlock Text="Thiếu điểm" FontSize="11" Foreground="#334155"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- NUT AN / HIEN BIEU DO -->
                                    <Button HorizontalAlignment="Right" Content="Ẩn / Hiện biểu đồ" Command="{Binding ChuyenTrangThaiBieuDoCommand}" Style="{StaticResource OutlineSmallBtn}"/>
                                </Grid>

                                <!-- NOI DUNG BIEU DO -->
                                <ScrollViewer Visibility="{Binding HienThiBieuDo, Converter={StaticResource BoolToVis}}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                                    <ItemsControl ItemsSource="{Binding DanhSachBieuDo}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="140" Margin="0,0,8,0" Padding="4,2" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                                                    <StackPanel>
                                                        <!-- KHUNG COT CAO 95px -->
                                                        <Grid Height="95">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- COT DAT -->
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding SoDat}" FontSize="10" FontWeight="Bold" Foreground="#27813C" HorizontalAlignment="Center" Margin="0,0,0,1"/>
                                                                <Border Width="22" Height="{Binding ChieuRongDat}" Background="#27813C" CornerRadius="2,2,0,0" VerticalAlignment="Bottom"/>
                                                            </StackPanel>

                                                            <!-- COT TRUOT -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding SoTruot}" FontSize="10" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Center" Margin="0,0,0,1"/>
                                                                <Border Width="22" Height="{Binding ChieuRongTruot}" Background="#D32F2F" CornerRadius="2,2,0,0" VerticalAlignment="Bottom"/>
                                                            </StackPanel>

                                                            <!-- COT THIEU DIEM -->
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding SoThieuDiem}" FontSize="10" FontWeight="Bold" Foreground="#C46A12" HorizontalAlignment="Center" Margin="0,0,0,1"/>
                                                                <Border Width="22" Height="{Binding ChieuRongThieuDiem}" Background="#E69A28" CornerRadius="2,2,0,0" VerticalAlignment="Bottom"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- TRUC NGANG -->
                                                        <Border Height="1" Background="#CBD5E1" Margin="0,1,0,3"/>

                                                        <!-- NHAN TUNG COT -->
                                                        <Grid Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="Đạt" FontSize="9.5" Foreground="#27813C" HorizontalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="Trượt" FontSize="9.5" Foreground="#D32F2F" HorizontalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="Thiếu" FontSize="9.5" Foreground="#C46A12" HorizontalAlignment="Center"/>
                                                        </Grid>

                                                        <!-- TEN MON HOC VA HOC KY -->
                                                        <TextBlock Text="{Binding TenNhom}" FontSize="10" FontWeight="SemiBold" Foreground="#174A78" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxHeight="28" ToolTip="{Binding TenNhom}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- BANG THONG KE DAT VA TRUOT -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding DanhSachThongKe}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F8FAFC"
                                  RowHeight="27"
                                  ColumnHeaderHeight="30"
                                  BorderBrush="#CBD5E1"
                                  FontSize="11.5"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã môn" Binding="{Binding MaMonHoc}" Width="80"/>
                                <DataGridTextColumn Header="Tên môn học" Binding="{Binding TenMonHoc}" MinWidth="150" Width="*"/>
                                <DataGridTextColumn Header="Số TC" Binding="{Binding SoTinChi}" Width="65"/>
                                <DataGridTextColumn Header="Học kỳ" Binding="{Binding TenHocKy}" Width="95"/>
                                <DataGridTextColumn Header="Năm học" Binding="{Binding NamHoc}" Width="90"/>
                                <DataGridTextColumn Header="Tổng SV" Binding="{Binding TongSinhVien}" Width="75"/>
                                <DataGridTextColumn Header="SV đạt" Binding="{Binding SoSinhVienDat}" Width="75"/>
                                <DataGridTextColumn Header="SV trượt" Binding="{Binding SoSinhVienTruot}" Width="75"/>
                                <DataGridTextColumn Header="SV thiếu điểm" Binding="{Binding SoSinhVienThieuDiem}" Width="95"/>
                                <DataGridTextColumn Header="Tỷ lệ đạt (%)" Binding="{Binding TyLeDat, StringFormat={}{0:0.00}}" Width="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 2: CANH BAO HOC VU & THIEU DIEM -->
            <TabItem Style="{StaticResource ClassicTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️ Danh sách cảnh báo học vụ" VerticalAlignment="Center"/>
                        <Border Background="#D97706" CornerRadius="7" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SoCanhBao}" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>

                <Border Background="White" CornerRadius="0,4,4,4" Padding="10" BorderBrush="#CBD5E1" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- TIEU DE HUONG DAN CANH BAO -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="DANH SÁCH SINH VIÊN CẦN BỔ SUNG ĐIỂM (CẢNH BÁO VIEW)" FontSize="12.5" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                            <TextBlock Text="* Các trường hợp thiếu điểm thành phần cần đôn đốc bổ sung trước khi khóa sổ điểm" Foreground="#64748B" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- BANG CANH BAO THIEU DIEM -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding DanhSachCanhBao}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#FFF9F5"
                                  RowHeight="27"
                                  ColumnHeaderHeight="30"
                                  BorderBrush="#CBD5E1"
                                  FontSize="11.5"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã SV" Binding="{Binding MaSV}" Width="80"/>
                                <DataGridTextColumn Header="Họ tên sinh viên" Binding="{Binding HoTen}" Width="160"/>
                                <DataGridTextColumn Header="Mã môn" Binding="{Binding MaMonHoc}" Width="80"/>
                                <DataGridTextColumn Header="Tên môn học" Binding="{Binding TenMonHoc}" MinWidth="140" Width="*"/>
                                <DataGridTextColumn Header="Học kỳ" Binding="{Binding TenHocKy}" Width="95"/>
                                <DataGridTextColumn Header="Năm học" Binding="{Binding NamHoc}" Width="90"/>
                                <DataGridTextColumn Header="Chuyên cần" Binding="{Binding DiemChuyenCan}" Width="85"/>
                                <DataGridTextColumn Header="Giữa kỳ" Binding="{Binding DiemGiuaKy}" Width="80"/>
                                <DataGridTextColumn Header="Cuối kỳ" Binding="{Binding DiemCuoiKy}" Width="80"/>
                                <DataGridTextColumn Header="Nội dung cảnh báo" Binding="{Binding NoiDungCanhBao}" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
